        "from ultralytics import YOLO\n",
        "import matplotlib.pyplot as plt\n",
        "import cv2\n",
        "import os\n",
        "\n",
        "\n",
        "model = YOLO('/content/runs/detect/imporoved_gem_model/weights/best.pt')\n",
        "\n",
        "\n",
        "results = model.predict(source='/content/000054.jpg', save=True, conf=0.25)\n",
        "\n",
        "res_dir = results[0].save_dir\n",
        "img_name = '000054.jpg'\n",
        "result_img_path = os.path.join(res_dir, img_name)\n",
        "\n",
        "\n",
        "if os.path.exists(result_img_path):\n",
        "    img = cv2.imread(result_img_path)\n",
        "    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
        "    plt.figure(figsize=(10, 10))\n",
        "    plt.imshow(img)\n",
        "    plt.axis('off')\n",
        "    plt.title(f\"Prediction Result\")\n",
        "    plt.show()\n",
        "else:\n",
        "    print(f\"Can't find the image at: {result_img_path}\")"
