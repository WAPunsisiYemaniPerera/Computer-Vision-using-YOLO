        "import os\n",
        "import shutil\n",
        "\n",
        "os.makedirs('/content/clean_dataset/images', exist_ok=True)\n",
        "os.makedirs('/content/clean_dataset/labels', exist_ok=True)\n",
        "\n",
        "img_dir = '/content/dataset/Crystals Detection/images'\n",
        "lbl_dir = '/content/dataset/Crystals Detection/labels'\n",
        "\n",
        "#copy the images\n",
        "images = sorted(os.listdir(img_dir))\n",
        "labels = sorted(os.listdir(lbl_dir))\n",
        "\n",
        "for img_f in images:\n",
        "  #get the image name\n",
        "  img_name = os.path.splitext(img_f)[0]\n",
        "\n",
        "  #search for the file which has image name\n",
        "  matching_label = [l for l in labels if img_name in l]\n",
        "\n",
        "  if matching_label:\n",
        "    #put image to the new location\n",
        "    shutil.copy(os.path.join(img_dir, img_f), f'/content/clean_dataset/images/{img_f}')\n",
        "    shutil.copy(os.path.join(lbl_dir, matching_label[0]), f'/content/clean_dataset/labels/{img_name}.txt')\n",
        "\n",
        "print(f\"Done! Images: {len(os.listdir('/content/clean_dataset/images'))}, Labels: {len(os.listdir('/content/clean_dataset/labels'))}\")\n",
        "\n"
